# {{ ansible_managed }}
# Controller web nginx: TLS on {{ controller_nginx_port }} with an http
# redirect on {{ controller_nginx_http_port }}. Self-contained (no conf.d).
# Location rules follow AWX's own docker-compose nginx config (Apache-2.0).
worker_processes 1;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;
events { worker_connections 1024; }
http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    server_tokens off;
    access_log /dev/stdout;
    map $http_upgrade $connection_upgrade { default upgrade; "" close; }
    sendfile on;

    upstream uwsgi  { server 127.0.0.1:{{ controller_uwsgi_port }}; }
    upstream daphne { server 127.0.0.1:{{ controller_daphne_port }}; }

    server {
        listen {{ controller_nginx_http_port }} default_server;
        server_name _;
        return 301 https://$host:{{ controller_nginx_port }}$request_uri;
    }

    server {
        listen {{ controller_nginx_port }} ssl;
        server_name _;
        keepalive_timeout 65;

        ssl_certificate /etc/nginx/tower.crt;
        ssl_certificate_key /etc/nginx/tower.key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers on;

        location /static { alias /var/lib/awx/public/static/; }

        location ~ ^(/websocket/|/api/websocket/|/api/controller/v2/websocket/) {
            proxy_pass http://daphne;
            proxy_http_version 1.1;
            proxy_buffering off;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Host $http_host;
            proxy_redirect off;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }

        location / {
            uwsgi_read_timeout 120s;
            uwsgi_pass uwsgi;
            include /etc/nginx/uwsgi_params;
        }
    }
}
