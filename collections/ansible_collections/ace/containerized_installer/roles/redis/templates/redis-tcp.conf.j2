# {{ ansible_managed }}
# Standalone TLS instance for the gateway.
port 0
tls-port {{ redis_tcp_port }}
tls-cert-file /etc/redis-tls/redis-tcp.cert
tls-key-file /etc/redis-tls/redis-tcp.key
tls-ca-cert-file /etc/redis-tls/ca.cert
tls-auth-clients no
requirepass {{ redis_password }}
dir /data
save 60 1
loglevel warning
