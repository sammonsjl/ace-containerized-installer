# {{ ansible_managed }}
# Self-contained nginx config for the gateway container (no conf.d includes).
worker_processes auto;
error_log /var/log/nginx/error.log;
pid /tmp/nginx.pid;

include /usr/share/nginx/modules/*.conf;

events {
    worker_connections 1024;
}

http {
    log_format main '$remote_addr "$http_x_envoy_external_address" - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent ($request_time) "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for" request-id: "$http_x_request_id"';

    access_log /var/log/nginx/access.log main;

    sendfile            on;
    tcp_nopush          on;
    tcp_nodelay         on;
    keepalive_timeout   65;
    types_hash_max_size 4096;

    include             /etc/nginx/mime.types;
    default_type        application/octet-stream;
    types {
        application/manifest+json webmanifest;
    }

    upstream uwsgi {
        server 127.0.0.1:{{ gateway_uwsgi_port }};
    }

    server {
        listen {{ gateway_nginx_port }} default_server ssl;
        server_name _;

        keepalive_timeout 65;

        ssl_certificate /etc/ansible-automation-platform/gateway/gateway.crt;
        ssl_certificate_key /etc/ansible-automation-platform/gateway/gateway.key;

        ssl_session_timeout 1d;
        ssl_session_cache shared:SSL:50m;
        ssl_session_tickets off;

        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers on;

        add_header Strict-Transport-Security max-age=15768000;
        add_header X-Content-Type-Options nosniff;

        # API static files (collected at image build)
        location ^~ /static/ {
            alias /opt/aap_gateway/static/;
        }

        # API endpoints
        location ~* /(v3|api|o|\.well-known)/ {
            uwsgi_pass uwsgi;
            uwsgi_read_timeout 120s;
            include /etc/nginx/uwsgi_params;
        }

        # UI assets
        location ~* \.(json|woff|woff2|jpe?g|png|gif|ico|svg|css|js)$ {
            root /opt/aap_gateway/platform_ui;
            add_header Cache-Control "public, max-age=31536000, s-maxage=31536000, immutable";
            try_files $uri =404;
            gzip_static on;
        }

        # UI root (SPA)
        location / {
            root /opt/aap_gateway/platform_ui;
            autoindex off;
            expires off;
            add_header Cache-Control "public, max-age=0, s-maxage=0, must-revalidate" always;
            try_files $uri /index.html =404;
        }
    }
}
