# {{ ansible_managed }}
# Single-node receptor: local-only control socket, no TCP listener, no mesh
# TLS, no work signing. (The 2-VM variant adds tcp-listener/tcp-peer with the
# mesh CA and work-signing keys.)
---
- node:
    id: {{ ace_hostname }}
    datadir: /var/lib/receptor

- log-level:
    level: info

# No TCP backends on a single node — this keeps receptor running anyway.
- local-only:

- control-service:
    service: control
    filename: /run/receptor/receptor.sock
    permissions: '0660'

- work-command:
    worktype: local
    command: ansible-runner
    params: worker
    allowruntimeparams: true

# Container-group execution: AWX submits kubernetes-runtime-auth work with
# the kubeconfig/bearer credential passed at runtime (no static cluster
# config on the node).
- work-kubernetes:
    worktype: kubernetes-runtime-auth
    authmethod: runtime
    allowruntimeauth: true
    allowruntimepod: true
    allowruntimeparams: true
